    <!-- 即時購買通知 Toast -->
    <style>
      #gyt-toast {
        position: fixed;
        bottom: 24px;
        left: 20px;
        z-index: 9999;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 8px 32px rgba(26,39,68,.22), 0 1px 4px rgba(0,0,0,.08);
        padding: 12px 38px 12px 12px;
        display: flex;
        align-items: center;
        gap: 11px;
        max-width: 310px;
        border-left: 3px solid #c9a84c;
        font-family: "Noto Serif TC", "PingFang TC", "Microsoft JhengHei", Georgia, serif;
        opacity: 0;
        transform: translateX(-110%);
        transition: opacity 0.45s ease, transform 0.45s cubic-bezier(.34,1.56,.64,1);
        pointer-events: none;
      }
      #gyt-toast.gyt-show {
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
      }
      #gyt-toast.gyt-hide {
        opacity: 0;
        transform: translateX(-110%);
      }
      /* 商品縮圖 */
      .gyt-t-thumb {
        width: 48px; height: 48px; border-radius: 8px;
        object-fit: cover; flex-shrink: 0;
        background: linear-gradient(135deg, #1a2744, #2d4070);
        display: flex; align-items: center; justify-content: center;
        font-size: 22px; overflow: hidden;
      }
      .gyt-t-thumb img {
        width: 100%; height: 100%; object-fit: cover; border-radius: 8px;
      }
      .gyt-t-body { flex: 1; min-width: 0; }
      .gyt-t-title {
        font-size: 12.5px; font-weight: 600; color: #1a2744;
        line-height: 1.45; margin-bottom: 2px;
      }
      .gyt-t-title .gyt-t-region { color: #c9a84c; }
      .gyt-t-title .gyt-t-cname  { color: #1a2744; }
      .gyt-t-product {
        font-size: 12px; color: #444; font-weight: 500;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        margin-bottom: 2px;
      }
      .gyt-t-sub {
        font-size: 11px; color: #aaa;
        display: flex; align-items: center; gap: 4px;
        overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
      }
      .gyt-t-amount { color: #c9a84c; font-weight: 600; font-size: 11px; }
      .gyt-t-dot { width: 3px; height: 3px; border-radius: 50%; background: #ddd; flex-shrink:0; }
      .gyt-t-close {
        position: absolute; top: 8px; right: 10px;
        font-size: 13px; color: #ccc; cursor: pointer;
        line-height: 1; padding: 2px;
      }
      .gyt-t-close:hover { color: #999; }
      .gyt-t-prog {
        position: absolute; bottom: 0; left: 0; height: 2px;
        background: linear-gradient(to right, #1a2744, #c9a84c);
        border-radius: 0 0 0 14px;
        transition: none;
      }
      @media (max-width: 480px) {
        #gyt-toast { max-width: calc(100vw - 32px); left: 16px; bottom: 16px; }
      }
    .daiko-highprice-note {
  display: flex;
