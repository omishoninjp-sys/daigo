          msg: '⚠ BUYMA 為日本個人代購（Personal Shopper）平台，本服務不代購其他代購平台的商品。\n\nBUYMA 上的商品本身就是賣家代購的，建議直接提供商品原本品牌的官方網站連結，可省下中間代購費用。\n\n如需代購日本商品，請改用 Amazon JP、ZOZOTOWN 等購物網站。'
        },
        {
          pattern: /buyee\.jp/i,
          msg: '⚠ Buyee 為日本代購／轉運平台，本服務不代購其他代購平台的商品。\n\nBuyee 上的商品多來自 Mercari、Yahoo 拍賣、樂天等網站，建議直接提供原始網站連結（例如 jp.mercari.com 的商品連結），可省下中間代購費用。'
        },
      ];
      for (var _i = 0; _i < BLOCKED_SITES.length; _i++) {
        if (BLOCKED_SITES[_i].pattern.test(url)) {
          alert(BLOCKED_SITES[_i].msg);
          return;
        }
      }

      if (typeof _orig === 'function') _orig();
    };
  });
</script>
{%- comment -%}
  ── daigo ?url= 預填 ──────────────────────────────────────────────
  用途：文章裡的「幫我買這個 →」按鈕帶著日本站商品網址過來，
        自動填入 #daiko-url，讓讀者不用回原站複製連結。

  貼在哪：sections/daigo.liquid，放在既有那段
          （定義 window.DAIKO_CONFIG / daikoCheckHighPrice 的）
          <script> 之後，緊接著貼上整段即可。不要動 assets/daigo.js。

  刻意不自動送出：
    這些 ?url= 連結會被 Googlebot 爬。自動觸發 daikoSearch() 等於
    每被爬一次就打一次 /api/scrape（會開 Selenium）。所以只填不送，
    讀者自己按「開始代購」。文章端的連結另外要加 rel="nofollow"。

  網域比對一律走 hostMatches()：完整網域或其子網域。
  絕對不可以改成 host.indexOf(d) !== -1 —— base.py 的註解記著，
  第一版用子字串比對誤擋了 7 家正常商店（"t.co" 命中 tocco-closet.co.jp）。
{%- endcomment -%}

<script>
(function () {
  'use strict';

  /* 有專屬 scraper 的網域（反推自 scrapers/base.py detect_platform） */
  var ALLOW = [
    'amazon.co.jp','amazon.jp','amzn.asia','amzn.to',
    'rakuten.co.jp','zozo.jp','zozotown.jp',
    'mercari.com',
    'uniqlo.com','gu-global.com','muji.com','beams.co.jp',
    'neighborhood.jp','wtaps.com','humanmade.jp','supreme.com','visvim.tv',
    'newbalance.jp','adidas.jp','snkrdunk.com',
    'amiami.jp','p-bandai.jp','animate-onlineshop.jp','pokemoncenter-online.com',
    'takaratomy.co.jp','takaratomymall.jp','nijisanji.jp',
    'hardoff.co.jp','biccamera.com',
    /* 二手平台：與 base.py 的 _SECONDHAND_HOSTS 及四則硬擋訊息裡的
       _ALT_CHANNELS 對齊 —— 訊息叫客人「改貼駿河屋／PayPay フリマ」，
       白名單沒有的話客人照做也貼不進來。
       ⚠️ auctions.yahoo.co.jp 刻意不列：該站競標與即決混在同一種網址，
          generic 取的是現在価格不是即決価格（實測低估 ¥9,000／¥1,100），
          即決 scraper 寫好之前不主動導流。理由同 base.py 的同名註解。 */
    'suruga-ya.jp','paypayfleamarket.yahoo.co.jp','mandarake.co.jp',
    /* Yahoo!ショッピング：6 個月 5 單 ¥121,418，2026-09-07 補上卡片時一併加。
       同樣不含 auctions.yahoo.co.jp（理由見上）。 */
    'store.shopping.yahoo.co.jp',
    'palcloset.jp','grail.bz','shop-list.com','shop-shimamura.com',
    'bellemaison.jp','daytona-park.com','runway-webstore.com','graniph.com',
    'nanouniverse.jp','ancellm.com',
    'fanatics.jp','softbankhawksstore.jp','npb.or.jp',
    'disney.co.jp','yoshidakaban.com','vermicular.jp',
    'marukyu-koyamaen.co.jp','mazdacollection.jp','yslb.jp','ec-store.net'
  ];

  /* 封鎖清單優先於白名單（同步自 base.py BLOCKED_DOMAINS） */
  var DENY = [
    'tw.mercari.com','amazon.com','hoka.com','duty-free-japan.jp',
    'bibian.co.jp','dokodemo.world','zenmarket.jp','tokukai.com',
    'letao.com.tw','daigobang.com','go1buy1.com'
  ];

  function hostMatches(host, domain) {
    return host === domain || host.slice(-(domain.length + 1)) === '.' + domain;
  }

  function pickUrl() {
    var raw;
    try {
      raw = new URLSearchParams(window.location.search).get('url');
    } catch (e) { return null; }
    if (!raw) return null;

    var u;
    try { u = new URL(raw); } catch (e) { return null; }

    /* javascript: / data: / http: 一律拒絕 */
    if (u.protocol !== 'https:') return null;

    var host = u.hostname.toLowerCase().replace(/^www\./, '');

    var i;
    for (i = 0; i < DENY.length; i++) {
      if (hostMatches(host, DENY[i])) return null;
    }
    for (i = 0; i < ALLOW.length; i++) {
      if (hostMatches(host, ALLOW[i])) return u.href;
    }
    return null;
  }

  function fill() {
    var href = pickUrl();
    if (!href) return;

    var input = document.getElementById('daiko-url');
    if (!input) return;

    input.value = href;
    /* 讓既有監聽器（若有）知道值變了 */
    input.dispatchEvent(new Event('input', { bubbles: true }));

    /* 提示條：用 scoped id，避免撞 daigo 流程的固定 ID */
    var tip = document.createElement('div');
    tip.id = 'gpfill-notice';
    tip.setAttribute('style',
      'display:block;width:100%;box-sizing:border-box;' +
      'margin:10px 0 0;padding:12px 14px;background:#fff8e6;' +
      'border:1px solid rgba(240,165,0,.4);border-left:4px solid #f0a500;' +
      'border-radius:10px;font-size:13.5px;line-height:1.7;color:#444;');
    tip.innerHTML = '<strong style="color:#1e2d5a;">已為你帶入商品連結</strong><br>' +
                    '確認網址正確後，按下方按鈕開始代購。';

    /* ★ 輸入框的直接 parent 是 flex 那一列（輸入框＋「貼上」按鈕）。
       插在裡面會變成第三個 flex 項目，把輸入框擠成一小條 —— 手機版實測過。
       所以先往上爬出所有 flex/grid 容器，再插在那一整列的後面。 */
    var row = input;
    while (row.parentNode && row.parentNode !== document.body) {
      var disp = '';
      try { disp = window.getComputedStyle(row.parentNode).display; } catch (e) {}
      if (disp !== 'flex' && disp !== 'inline-flex' &&
          disp !== 'grid' && disp !== 'inline-grid') break;
      row = row.parentNode;
    }
    if (row.parentNode) {
      row.parentNode.insertBefore(tip, row.nextSibling);
    }

    try {
      input.focus({ preventScroll: true });
      input.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (e) {
      input.focus();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fill);
  } else {
    fill();
  }
})();
</script>

