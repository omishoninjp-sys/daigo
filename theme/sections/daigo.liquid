      var SHOW_DURATION = 5000;
      var HIDE_DURATION = 8000;
      var RELOAD_INTERVAL = 120000;

      var toast    = document.getElementById('gyt-toast');
      var titleEl  = document.getElementById('gytToastTitle');
      var thumbEl  = document.getElementById('gytToastThumb');
      var productEl= document.getElementById('gytToastProduct');
      var subEl    = document.getElementById('gytToastSub');
      var prog     = document.getElementById('gytToastProg');
      var closeBtn = document.getElementById('gytToastClose');

      var orders = [];
      var idx    = 0;
      var showTimer, hideTimer, reloadTimer;
      var dismissed = false;

      closeBtn.addEventListener('click', function () {
        dismissed = true;
        hide();
        clearTimeout(showTimer);
        clearTimeout(hideTimer);
      });

      function runProg() {
        prog.style.transition = 'none';
        prog.style.width = '0%';
        requestAnimationFrame(function () { requestAnimationFrame(function () {
          prog.style.transition = 'width ' + SHOW_DURATION + 'ms linear';
          prog.style.width = '100%';
        }); });
      }

      function show(order) {
        /* ── 縮圖 ── */
        if (order.image) {
          thumbEl.innerHTML = '<img src="' + order.image + '" alt="" loading="lazy">';
        } else {
          thumbEl.innerHTML = '🛍️';
        }

        /* ── 標題：XX市 單XX 的顧客完成代購 ── */
        var nameHtml = order.customer
          ? ' <span class="gyt-t-cname">' + order.customer + '</span>'
          : '';
        titleEl.innerHTML =
          '<span class="gyt-t-region">' + order.flag + ' ' + order.region + '</span>' +
          nameHtml + ' 的顧客完成代購';

        /* ── 商品名 ── */
        productEl.textContent = order.product;

        /* ── 底部資訊：金額 · 件數 · 時間 ── */
        var parts = [];
        if (order.amount) parts.push('<span class="gyt-t-amount">' + order.amount + '</span>');
        if (order.count && order.count > 1) parts.push(order.count + ' 件');
        parts.push('<span>' + order.time + '</span>');

        subEl.innerHTML = parts.join('<span class="gyt-t-dot"></span>');

        toast.classList.remove('gyt-hide');
        toast.classList.add('gyt-show');
        runProg();
      }

      function hide() {
        toast.classList.remove('gyt-show');
        toast.classList.add('gyt-hide');
      }

      function cycle() {
        if (dismissed || orders.length === 0) return;
        show(orders[idx]);
        idx = (idx + 1) % orders.length;

        showTimer = setTimeout(function () {
          hide();
          hideTimer = setTimeout(cycle, HIDE_DURATION);
        }, SHOW_DURATION);
      }

      function load() {
        fetch(API_URL)
          .then(function (r) { return r.json(); })
          .then(function (json) {
            if (json.orders && json.orders.length > 0) {
              orders = json.orders;
              if (idx === 0 && !dismissed) {
                setTimeout(cycle, 3000);
              }
            }
          })
          .catch(function () {});
      }

      load();
      reloadTimer = setInterval(load, RELOAD_INTERVAL);
    })();
    </script>

