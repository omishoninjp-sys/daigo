    <style>
      /* ── 截圖傳 LINE 代購區塊 ── */
      .daiko-snaphelp{ margin:0 auto 8px; }
      .daiko-snaphelp-card{
        background:#fbfaf7; border:1px solid #ece6d8;
        border-radius:16px; padding:26px 24px; text-align:center;
      }
      .daiko-snaphelp-title{
        margin:0 0 8px; font-size:19px; font-weight:800;
        line-height:1.4; color:#1a2744;
      }
      .daiko-snaphelp-sub{
        margin:0 0 18px; font-size:14px; line-height:1.75; color:#6b6557;
      }
      .daiko-snaphelp-steps{
        list-style:none; margin:0 0 20px; padding:0;
        display:flex; flex-wrap:wrap; justify-content:center; gap:10px 18px;
      }
      .daiko-snaphelp-steps li{
        display:flex; align-items:center; gap:8px;
        font-size:14px; color:#1a2744;
      }
      .daiko-snaphelp-steps li span{
        width:24px; height:24px; flex:none;
        display:inline-flex; align-items:center; justify-content:center;
        border-radius:50%; background:#c9a84c; color:#fff;
        font-size:13px; font-weight:700;
      }
      .daiko-snaphelp-btn{
        display:inline-flex; align-items:center; justify-content:center; gap:9px;
        width:100%; max-width:320px; box-sizing:border-box;
        padding:14px 22px; border-radius:12px;
        background:#06c755; color:#fff;
        font-size:16px; font-weight:800; text-decoration:none;
        box-shadow:0 4px 14px rgba(6,199,85,.28);
        transition:transform .12s ease, box-shadow .12s ease, filter .12s ease;
      }
      .daiko-snaphelp-btn:hover{
        transform:translateY(-1px); filter:brightness(1.04);
        box-shadow:0 6px 18px rgba(6,199,85,.34);
      }
      .daiko-snaphelp-btn:active{ transform:translateY(0); }
      .daiko-snaphelp-btn svg{ width:22px; height:22px; flex:none; }
      .daiko-snaphelp-note{
        margin:14px 0 0; font-size:12.5px; line-height:1.6; color:#9a9384;
      }
      @media (max-width:480px){
        .daiko-snaphelp-card{ padding:22px 18px; }
        .daiko-snaphelp-title{ font-size:18px; }
        .daiko-snaphelp-steps{
          flex-direction:column; align-items:flex-start;
          width:max-content; margin-left:auto; margin-right:auto;
        }
      }
    </style>

